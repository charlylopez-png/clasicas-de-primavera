# Conexión a la base de datos (Vercel Postgres / Neon).
# Vercel la rellena automáticamente al conectar la integración de Storage
# al proyecto; en local, cópiala desde el dashboard de Vercel → Storage.
DATABASE_URL=

# Secreto para firmar las cookies de sesión. Genera uno con:
#   openssl rand -base64 32
JWT_SECRET=

# El email con el que te registres con este valor se convierte
# automáticamente en administrador (aprobado, rol admin) al crear cuenta.
ADMIN_EMAIL=charly.lopez@gmail.com
